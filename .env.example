# Cloud Database Configuration
# Choose one provider and fill in the credentials

# Option 1: Supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Option 2: Cloudflare D1
# VITE_CLOUDFLARE_D1_DATABASE_ID=your-database-id

# Option 3: Generic cloud database
# VITE_DATABASE_URL=postgresql://user:password@host:5432/dbname
# VITE_DATABASE_API_KEY=your-api-key

# App configuration
# VITE_APP_URL=https://your-app.vercel.app
